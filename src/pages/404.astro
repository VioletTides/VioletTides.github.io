---
// GitHub Pages serves this for any unknown path. It uses the project page's reading column.
import Base from '../layouts/Base.astro';
---
<Base title="Not found" description="This page does not exist.">
  <main>
    <section class="static">
      <div class="article book">
        <h1>Not found</h1>
        <p>Nothing grows at this address. <a href="/">Go back to the tree</a>.</p>
      </div>
    </section>
  </main>
</Base>
